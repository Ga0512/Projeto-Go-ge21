# O dado NUNCA entra na imagem — vem pelo volume (ver docker/LEIAME.md).
# Pacotes de dataset: se um .tar.gz ficar na pasta do repositorio, o build
# manda os GB dele para o daemon antes de comecar. Fica de fora.
*.tar.gz
*.tar
*.zip
Data/dados/
Data/_para_apagar/
Data/experimentos/
Data/receitas/

# artefatos de treino: ficam no volume
Models/*/runs/
Models/*/inferencias/
Models/.cache/
Models/vit_model/dados/
Models/xgboost/teste_acelerar_randomforest/mapas/

# pesos e rasters, onde quer que apareçam
*.pth
*.pt
*.ubj
*.onnx
*.tif
*.tiff
*.vrt
*.npz
*.npy
*.gpkg
*.shp

# ambientes e caches locais
.venv/
Data/.venv/
__pycache__/
*.py[cod]
.git/
*.log
*.bak
